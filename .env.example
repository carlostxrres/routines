# Supabase project (Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Same URL as above, without the VITE_ prefix: the serverless functions read it
# from the server environment, not from the bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres (Project Settings -> Database)
# Pooler (Supavisor, port 6543) - used by the app at runtime
DATABASE_URL=
# Direct connection (port 5432) - used by drizzle-kit for DDL
DIRECT_URL=
