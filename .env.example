# Supabase project (Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Same URL as above, without the VITE_ prefix: the serverless functions read it
# from the server environment, not from the bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres (Project Settings -> Database -> Connection string).
#
# Use the POOLER host for both. It is not just a different port: the pooler is
# a different hostname (aws-N-<region>.pooler.supabase.com) and takes the user
# postgres.<project-ref>, while the "direct" host (db.<project-ref>.supabase.co,
# user postgres) only publishes an AAAA record. On a network without IPv6 —
# most home connections, and Vercel's functions — the direct host fails with
# ENETUNREACH and the pooler's session mode is the substitute for it.
#
# Transaction mode, port 6543. Used by the app at runtime.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Session mode, port 5432. Used by drizzle-kit, which needs a connection that
# supports DDL.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
